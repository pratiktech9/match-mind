# Google OAuth Configuration
# Get these from Google Cloud Console: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Optional: Restrict access to specific Google Workspace domain
# Leave empty to allow any Google account
GOOGLE_HD_DOMAIN=yourcompany.com

# Optional: Restrict access to specific email domains
# Comma-separated list of allowed domains (e.g., "company.com,subsidiary.com")
# Leave empty to allow all domains
ALLOWED_EMAIL_DOMAINS=yourcompany.com

# Rails Configuration
RAILS_ENV=development
SECRET_KEY_BASE=your_secret_key_base_here

# Database Configuration
DATABASE_URL=postgresql://username:password@localhost/match_mind_development
